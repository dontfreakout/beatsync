{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beatsync Streamer",
  "version": "0.1.0",
  "identifier": "app.beatsync.streamer",
  "build": {
    "beforeDevCommand": "bun run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Beatsync Streamer",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "targets": ["rpm", "deb", "appimage"],
    "linux": {
      "rpm": { "depends": ["pipewire"] },
      "deb": { "depends": ["pipewire"] }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
