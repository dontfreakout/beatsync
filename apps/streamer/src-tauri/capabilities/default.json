{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: core defaults and the app's own commands",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-settings",
    "allow-save-settings",
    "allow-list-apps",
    "allow-start-stream",
    "allow-update-apps",
    "allow-stop-stream",
    "allow-subscribe-status"
  ]
}
